# 백엔드 설정 예시. 이 파일을 .env 로 복사해 값을 채운다.
# .env 는 git에 올리지 않는다(.gitignore 확인).

# --- 기본 ---
# 외부에 배포할 때는 false로 두면 업로드 전용으로 동작한다
ENABLE_YOUTUBE=true

# OneDrive 폴더에서는 코드 변경 감지가 불안정해 기본이 꺼져 있다
RELOAD=false

# --- LLM (선택) ---
# 가사를 더 잘 찾기 위해 영상 제목에서 가수·곡명을 가려내고
# 로마자 표기를 만드는 데만 쓴다. 오디오 분석에는 쓰지 않는다.
# 비워 두면 이 기능만 꺼지고 나머지는 그대로 돈다.
#
# 한국 가요가 가사 데이터베이스에 영문으로 등록된 경우를 건진다:
#   "조용필 단발머리" → 0건 / "Cho Yong Pil" → 20건(동기화 가사 포함)
LLM_API_KEY=
# OpenAI 호환 API면 무엇이든 된다(로컬 모델 포함)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4-mini
